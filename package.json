{
  "name": "the-ledger",
  "version": "0.1.0",
  "description": "An epistemic ledger of AI history — tracking how understanding changes over time.",
  "private": true,
  "type": "module",
  "scripts": {
    "build:vercel": "node scripts/build-vercel.mjs",
    "test:vercel": "node --test scripts/vercel-output.test.mjs",
    "validate": "tsx scripts/validate.ts",
    "check-links": "tsx scripts/check-links.ts",
    "build-graph": "tsx scripts/build-graph.ts",
    "generate-feed": "tsx scripts/generate-feed.ts",
    "test:links": "tsx --test --test-concurrency=2 scripts/check-links.test.ts",
    "test:security": "tsx --test scripts/content-security.test.ts",
    "test:parity": "tsx scripts/test-parity.ts",
    "test:no-dark-leaks": "tsx scripts/test-no-dark-leaks.ts",
    "test:build": "npm run build-graph && npm run generate-feed && cd site && npm run build && cd .. && npm run test:parity && npm run test:no-dark-leaks && npm run test:security"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "gray-matter": "^4.0.3",
    "js-yaml": "^5.5.0",
    "node-fetch": "^3.3.2",
    "tldts": "^7.4.19",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "CC-BY-SA-4.0"
}
