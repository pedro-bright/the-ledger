---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/wiki/PageHeader.astro';
import Graph from '../components/Graph';
import fs from 'node:fs';
import { fileURLToPath } from 'node:url';

// Resolve graph.json relative to this file so the path is stable regardless of cwd.
const graphPath = fileURLToPath(new URL('../../../graph.json', import.meta.url));
const graph: { nodes: { id: string; title: string; type: 'event' | 'thread' | 'controversy' | 'actor'; date?: string }[]; edges: { source: string; target: string; type: string }[] } = JSON.parse(fs.readFileSync(graphPath, 'utf-8'));

const nodeCount = graph.nodes.length;
const edgeCount = graph.edges.length;

const legend = [
  { type: 'event', label: 'Events', color: '#0645AD' },
  { type: 'thread', label: 'Threads', color: '#B45309' },
  { type: 'controversy', label: 'Controversies', color: '#B91C1C' },
  { type: 'actor', label: 'Actors', color: '#047857' },
];
const nodeById = new Map(graph.nodes.map((node) => [node.id, node]));
const route = (node: typeof graph.nodes[number]) =>
  `/${{ event: 'events', thread: 'threads', controversy: 'controversies', actor: 'actors' }[node.type]}/${node.id}`;
const connections = new Map(graph.nodes.map((node) => [node.id, { incoming: [] as typeof graph.edges, outgoing: [] as typeof graph.edges }]));
for (const edge of graph.edges) {
  connections.get(edge.source)?.outgoing.push(edge);
  connections.get(edge.target)?.incoming.push(edge);
}

---

<Base
  layout="index"
  title="Graph"
  description="Relationship graph: events, threads, controversies, and actors connected."
>
  <PageHeader
    eyebrow="§ Graph"
    title="How everything connects"
    subtitle={`${nodeCount} nodes, ${edgeCount} edges. Events belong to threads, threads contain controversies, events reference actors. Toggle node types with the controls to isolate a subnetwork.`}
    noRule
  />

  <div class="graph-legend" aria-label="Node-type legend">
    <p class="label-eyebrow">Legend</p>
    <ul class="graph-legend__list">
      {legend.map((l) => (
        <li class="graph-legend__item">
          <span
            class="graph-legend__swatch"
            style={`background:${l.color}`}
            aria-hidden="true"
          ></span>
          <span class="graph-legend__label">{l.label}</span>
        </li>
      ))}
    </ul>
  </div>

  <div class="graph-wrap" data-graph-state="loading">
    <div class="graph-placeholder" role="status">
      <p class="graph-loading-message">Loading relationship graph.</p>
      <p class="graph-failure-message" hidden>The graph could not load.</p>
      <p><a href="#graph-relationships">Browse records and relationships below</a><span class="graph-retry" hidden> or <a href="/graph">Retry graph</a></span>.</p>
      <noscript>
        <style is:inline>
          .graph-loading-message { display: none; }
          .graph-wrap[data-graph-state] { min-height: 0; }
          .graph-wrap .graph-placeholder { position: static; }
        </style>
        <p>JavaScript is required for the canvas. Records and relationships are available below.</p>
      </noscript>
    </div>
    <Graph data={graph} client:only="react" />
  </div>

  <details id="graph-relationships" class="graph-fallback">
    <summary class="graph-fallback__summary">All {nodeCount} records and their relationships</summary>
    <p>Choose a record to read its incoming and outgoing connections.</p>
    <div class="graph-fallback__body">
      {legend.map((group) => (
        <section class="graph-fallback__section" aria-labelledby={`relations-${group.type}`}>
          <h2 id={`relations-${group.type}`} class="graph-fallback__heading">{group.label}</h2>
          {graph.nodes.filter((node) => node.type === group.type).sort((a, b) => a.title.localeCompare(b.title)).map((node) => (
            <details data-record={node.id} class="graph-record">
              <summary>{node.title}</summary>
              <p><a href={route(node)}>Open {node.title}</a>{node.date && <time datetime={node.date}> - {node.date}</time>}</p>
              {(['outgoing', 'incoming'] as const).map((direction) => (
                <div>
                  <h3>{direction === 'outgoing' ? 'Outgoing connections' : 'Incoming connections'}</h3>
                  {connections.get(node.id)![direction].length ? (
                    <ul>
                      {connections.get(node.id)![direction].map((edge) => {
                        const related = nodeById.get(direction === 'outgoing' ? edge.target : edge.source)!;
                        return <li>{edge.type.replaceAll('_', ' ')}: <a href={route(related)}>{related.title}</a> <span>({related.type})</span></li>;
                      })}
                    </ul>
                  ) : <p>No {direction} connections.</p>}
                </div>
              ))}
            </details>
          ))}
        </section>
      ))}
    </div>
  </details>

  <details id="graph-directory" class="graph-fallback">
    <summary class="graph-fallback__summary">All {nodeCount} records as a linked list</summary>
    <div class="graph-fallback__body">
      {legend.map((group) => {
        const records = graph.nodes
          .filter((node) => node.type === group.type)
          .sort((a, b) => (b.date || '').localeCompare(a.date || '') || a.title.localeCompare(b.title));
        return (
          <section class="graph-fallback__section" aria-labelledby={`directory-${group.type}`}>
            <h2 id={`directory-${group.type}`} class="graph-fallback__heading">
              <span class="graph-fallback__dot" style={`background:${group.color}`} aria-hidden="true"></span>
              {group.label}
              <span class="graph-fallback__count font-mono tabular-nums">({records.length})</span>
            </h2>
            <ul class="graph-fallback__list">
              {records.map((node) => (
                <li>
                  <a href={route(node)}>{node.title}</a>
                  {node.date && <time class="graph-fallback__date font-mono" datetime={node.date}> - {node.date}</time>}
                </li>
              ))}
            </ul>
          </section>
        );
      })}
    </div>
  </details>
</Base>

<script>
  const wrapper = document.querySelector<HTMLElement>('.graph-wrap');
  if (wrapper) {
    window.setTimeout(() => {
      if (wrapper.dataset.graphState === 'ready') return;
      wrapper.dataset.graphState = 'failed';
      wrapper.querySelector<HTMLElement>('.graph-loading-message')!.hidden = true;
      wrapper.querySelector<HTMLElement>('.graph-failure-message')!.hidden = false;
      wrapper.querySelector<HTMLElement>('.graph-retry')!.hidden = false;
    }, 12000);
  }
</script>

<style>
  .graph-legend {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px 18px;
    margin: 0 0 18px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--color-rule);
  }
  .graph-legend__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
  }
  .graph-legend__item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-sans);
    font-size: 12px;
    color: var(--color-ink-mid);
  }
  .graph-legend__swatch {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .graph-legend__label {
    letter-spacing: 0.02em;
  }

  .graph-wrap {
    --graph-height: max(500px, calc(100svh - 280px));
    --graph-tools-height: 168px;
    --graph-help-height: 116px;
    position: relative;
    min-height: calc(var(--graph-height) + var(--graph-tools-height) + var(--graph-help-height) + 32px);
    margin: 8px 0 16px;
  }
  .graph-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 24px;
    border: 1px solid var(--color-rule-strong);
    font-family: var(--font-sans);
    font-size: 14px;
    text-align: center;
  }
  .graph-wrap[data-graph-state='ready'] .graph-placeholder { display: none; }
  .graph-wrap:not([data-graph-state='ready']) :global(astro-island) { visibility: hidden; }
  .graph-wrap :global(.graph-client) {
    display: grid;
    grid-template-rows: minmax(var(--graph-tools-height), auto) var(--graph-height) minmax(var(--graph-help-height), auto);
    gap: 16px;
  }
  .graph-wrap :global(.graph-tools) { display: flex; flex-direction: column; gap: 8px; }
  .graph-wrap :global(.graph-navigation) { display: flex; flex-wrap: wrap; gap: 4px; }
  .graph-wrap :global(.graph-pan) { display: inline-flex; gap: 4px; }
  .graph-wrap :global(.graph-navigation button) {
    border: 1px solid var(--color-rule-strong);
    border-radius: 2px;
    min-width: 40px;
    min-height: 40px;
    padding: 4px 10px;
    font-family: var(--font-sans);
    font-size: 12px;
    background: var(--color-wiki-surface);
    color: var(--color-ink);
  }
  .graph-wrap :global(.graph-client[data-gestures='disabled'] canvas) { touch-action: auto !important; }
  @media not all and (any-pointer: coarse) { .graph-wrap :global(.graph-touch-only) { display: none; } }
  .graph-record { margin: 8px 0; font-size: 14px; }
  .graph-record summary { cursor: pointer; }
  .graph-record p, .graph-record ul { margin: 8px 0; }
  .graph-record h3 { font-family: var(--font-sans); font-size: 12px; font-weight: 600; }
  .graph-record ul { padding-left: 18px; }
  .graph-record time { font-family: var(--font-mono); font-size: 12px; }
  @media (min-width: 640px) { .graph-wrap { --graph-tools-height: 96px; --graph-help-height: 64px; } }
</style>
