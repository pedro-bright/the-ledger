---
import Base from '../../layouts/Base.astro';
import ArticleShell from '../../components/wiki/ArticleShell.astro';
import Infobox from '../../components/wiki/Infobox.astro';
import RailSection from '../../components/wiki/RailSection.astro';
import CategoryTag from '../../components/wiki/CategoryTag.astro';
import SignificanceFlag from '../../components/wiki/SignificanceFlag.astro';
import ConfidenceBadge from '../../components/ConfidenceBadge';
import ContestationBadge from '../../components/ContestationBadge';
import SignificanceHistory from '../../components/SignificanceHistory';
import {
  loadEvents, loadThreads, loadActors, loadSummaryRevisions, loadChallenges, loadResolutions, splitArticleLead,
  getThreadEvents,
} from '../../lib/content';
import fs from 'node:fs';
import path from 'node:path';

export function getStaticPaths() {
  const events = loadEvents();
  return events.map((event) => ({
    params: { id: event.slug },
    props: { event },
  }));
}

const { event } = Astro.props;
const article = splitArticleLead(event.htmlContent);
const allEvents = loadEvents();
const threads = loadThreads();
const actors = loadActors();
const actorMap = new Map(actors.map((a) => [a.id, a]));
const eventMap = new Map(allEvents.map((e) => [e.id, e]));
const threadMap = new Map(threads.map((t) => [t.id, t]));

// Linked threads for this event.
const linkedThreads = (event.threads || []).map((id: string) => threadMap.get(id)).filter(Boolean);

// Earlier and later entries in each thread this event belongs to.
const threadNav = threads.flatMap((thread) => {
  const members = getThreadEvents(thread, allEvents);
  const i = members.findIndex((e) => e.id === event.id);
  const earlier = members[i - 1];
  const later = members[i + 1];
  return i !== -1 && (earlier || later) ? [{ thread, earlier, later }] : [];
});

// See also = this event's own `related` entries, then entries whose `related` cites it; newest first, cap 8 in total.
const ownRelated = [...new Set(event.related ?? [])]
  .map((id) => eventMap.get(id))
  .filter((e): e is (typeof allEvents)[number] => !!e && e.id !== event.id)
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .slice(0, 8);
const ownRelatedIds = new Set(ownRelated.map((e) => e.id));
const referencedBy = allEvents
  .filter((e) => e.id !== event.id && !ownRelatedIds.has(e.id) && e.related?.includes(event.id))
  .slice(0, 8 - ownRelated.length);

// Sister events in the same category, capped at 5.
const sisterEvents = allEvents.filter((e) => e.category === event.category && e.id !== event.id).slice(0, 5);

// Best-effort sourcePath — walk the year dir; if anything fails it's left undefined (cosmetic).
let sourcePath: string | undefined;
try {
  const year = new Date(event.date).getUTCFullYear();
  const CONTENT_DIR = path.resolve((import.meta as any).env?.CONTENT_DIR || path.join(process.cwd(), '..', 'content'));
  const match = fs.readdirSync(path.join(CONTENT_DIR, 'events', String(year))).find((f) => f.endsWith(`${event.slug}.md`));
  if (match) sourcePath = `content/events/${year}/${match}`;
} catch {}

const formatCategory = (c: string) => c.replace(/-/g, ' ').replace(/\b\w/g, (s) => s.toUpperCase());
const formatSourceType = (t: string) => t.replace(/_/g, ' ').replace(/-/g, ' ');
const isPrimary = (t?: string) => !!t && /^primary/.test(t);

const breadcrumb = [
  { label: 'Main page', href: '/' },
  { label: 'Timeline', href: '/explore' },
  { label: formatCategory(event.category), href: `/explore?cat=${event.category}` },
  { label: event.title },
];

const subtitle = `A ledger entry in the ${formatCategory(event.category).toLowerCase()} archive, dated ${event.date}.`;
const hasSigHistory = event.significance_history && event.significance_history.length > 1;
const description = `${event.title} — ${event.date}`;
const { created, last_reviewed: reviewed, final_author: finalAuthor } = event.revision ?? {};
const lastReviewed = reviewed && finalAuthor !== 'pedro-bright' && (!created || reviewed > created) ? reviewed : undefined;

// Correction records that concern this event, oldest first; a challenge precedes a revision made the same day.
const resolutions = loadResolutions();
const challengeRecords = loadChallenges()
  .filter((c) => c.target_claim_id === event.id)
  .map((c) => ({ kind: 'challenge' as const, date: c.opened_at, challenge: c, resolution: resolutions.find((r) => r.case_id === c.id) }));
const revisionRecords = loadSummaryRevisions()
  .filter((r) => r.target_summary_id === event.id)
  .map((r) => ({ kind: 'revision' as const, date: r.created_at, revision: r }));
const records = [...challengeRecords, ...revisionRecords].sort((a, b) => (a.date ?? '').localeCompare(b.date ?? ''));
const plainWords = (value: string) => value.replace(/_/g, ' ');
const contestationHref = records.length > 0 ? '#revision-history' : undefined;
---

<Base title={event.title} description={description} layout="article">
  <!-- LEFT RAIL -->
  <Fragment slot="leftRail">
    <RailSection title="Navigate">
      <ul class="rail-list">
        <li><a href="/explore">Back to timeline</a></li>
        <li><a href="/">Main page</a></li>
        <li><a href={`/explore?cat=${event.category}`}>{formatCategory(event.category)}</a></li>
        <li><a href="/threads">All threads</a></li>
      </ul>
    </RailSection>

    {linkedThreads.length > 0 && (
      <RailSection title="Related threads">
        <ul class="rail-list">
          {linkedThreads.map((t: any) => (
            <li><a href={`/threads/${t.slug}`}>{t.title}</a></li>
          ))}
        </ul>
      </RailSection>
    )}

    {sisterEvents.length > 0 && (
      <RailSection title={`${formatCategory(event.category)} · sister entries`}>
        <ul class="rail-list rail-list--stacked">
          {sisterEvents.map((e) => (
            <li class="rail-stack">
              <a href={`/events/${e.slug}`}>{e.title}</a>
              <time class="rail-stack__date font-mono" datetime={e.date}>{e.date}</time>
            </li>
          ))}
        </ul>
      </RailSection>
    )}
  </Fragment>

  <!-- RIGHT RAIL -->
  <Fragment slot="rightRail">
    {event.actors && event.actors.length > 0 && (
      <RailSection title="Actors">
        <ul class="rail-list rail-list--stacked">
          {event.actors.map((a: any) => {
            const actor = actorMap.get(a.id);
            return (
              <li class="rail-stack">
                <a href={`/actors/${a.id}`}>{actor?.name || a.id}</a>
                <span class="rail-stack__meta">
                  {actor?.type && <span class="rail-stack__type">{actor.type.replace(/-/g, ' ')}</span>}
                  {a.role && <span class="rail-stack__role">· {a.role}</span>}
                </span>
              </li>
            );
          })}
        </ul>
      </RailSection>
    )}

    <RailSection title="Epistemic key" id="epistemic-key">
      <dl class="epistemic-key">
        <dt class="epistemic-key__term epistemic-key__term--landmark">Landmark</dt>
        <dd>Fundamentally alters the trajectory. Future textbooks will cover it. 2–5 per year.</dd>
        <dt class="epistemic-key__term epistemic-key__term--major">Major</dt>
        <dd>Meaningfully shifts the landscape. 2–4 per month.</dd>
        <dt class="epistemic-key__term epistemic-key__term--notable">Notable</dt>
        <dd>Worth documenting for the record. Significance can be upgraded later.</dd>
        <dt class="epistemic-key__term">Confidence</dt>
        <dd>High = primary sources corroborate. Medium = credible secondary only. Low = provisional. Disputed = credible sources disagree.</dd>
        <dt class="epistemic-key__term">Contestation</dt>
        <dd>Uncontested = no formal challenge. Contested = at least one challenge filed. Superseded = replaced by a later entry. Unresolved = dispute still open.</dd>
      </dl>
    </RailSection>
  </Fragment>

  <!-- ARTICLE BODY -->
  <ArticleShell
    title={event.title}
    subtitle={subtitle}
    breadcrumb={breadcrumb}
    articleText={event.htmlContent}
    lastReviewed={lastReviewed}
    sourcePath={sourcePath}
  >
    <Fragment slot="markers">
      <SignificanceFlag level={event.significance} />
      <ConfidenceBadge level={event.confidence} />
      {event.contestation?.status !== 'uncontested' && (contestationHref && event.contestation?.status
        ? <a href={contestationHref}><ContestationBadge status={event.contestation.status} /></a>
        : <ContestationBadge status={event.contestation?.status} />)}
    </Fragment>

    <Fragment slot="infobox">
      <Infobox title="Entry metadata">
        <dl>
          <dt>Date</dt>
          <dd><time class="mono" datetime={event.date}>{event.date}</time></dd>
          <dt>Category</dt>
          <dd><a href={`/explore?cat=${event.category}`}><CategoryTag category={event.category} /></a></dd>
          {event.significance && <><dt>Significance</dt><dd><SignificanceFlag level={event.significance} /></dd></>}
          {event.confidence && event.confidence !== 'high' && <><dt>Confidence</dt><dd><ConfidenceBadge level={event.confidence} /></dd></>}
          {event.contestation?.status && (
            <>
              <dt>Contestation</dt>
              <dd>
                {contestationHref
                  ? <a href={contestationHref}><ContestationBadge status={event.contestation.status} /></a>
                  : <ContestationBadge status={event.contestation.status} />}
              </dd>
            </>
          )}
          {event.state && <><dt>State</dt><dd>{event.state}</dd></>}
          {event.actors && event.actors.length > 0 && (
            <>
              <dt>Actors</dt>
              <dd>
                <ul>
                  {event.actors.map((a: any) => {
                    const actor = actorMap.get(a.id);
                    return (
                      <li>
                        <a href={`/actors/${a.id}`}>{actor?.name || a.id}</a>
                        {a.role && <span class="infobox-role"> — {a.role}</span>}
                      </li>
                    );
                  })}
                </ul>
              </dd>
            </>
          )}
          {event.regions && event.regions.length > 0 && <><dt>Regions</dt><dd>{event.regions.join(', ')}</dd></>}
          {event.tags && event.tags.length > 0 && <><dt>Tags</dt><dd class="mono">{event.tags.join(', ')}</dd></>}
          {linkedThreads.length > 0 && (
            <>
              <dt>Threads</dt>
              <dd><ul>{linkedThreads.map((t: any) => <li><a href={`/threads/${t.slug}`}>{t.title}</a></li>)}</ul></dd>
            </>
          )}
          <dt>ID</dt>
          <dd><span class="mono">{event.id}</span></dd>
        </dl>
      </Infobox>
    </Fragment>

    <Fragment slot="lead" set:html={article.lead} />
    <!-- Rendered markdown body -->
    <Fragment set:html={article.body} />

    {threadNav.map(({ thread, earlier, later }) => (
      <nav class="thread-nav" aria-label={`${thread.title} thread`}>
        <a class="thread-nav__thread" href={`/threads/${thread.slug}`}>{thread.title}</a>
        <div class="thread-nav__steps">
          {earlier && (
            <p class="thread-nav__step">
              <span class="thread-nav__label">Earlier in this thread</span>
              <a href={`/events/${earlier.slug}`}>{earlier.title}</a>
              <time class="thread-nav__date font-mono" datetime={earlier.date}>{earlier.date}</time>
            </p>
          )}
          {later && (
            <p class="thread-nav__step thread-nav__step--later">
              <span class="thread-nav__label">Later in this thread</span>
              <a href={`/events/${later.slug}`}>{later.title}</a>
              <time class="thread-nav__date font-mono" datetime={later.date}>{later.date}</time>
            </p>
          )}
        </div>
      </nav>
    ))}

    {/* Mobile-only epistemic key — right rail is hidden below 780px. */}
    <details class="mobile-epistemic-key" aria-label="Epistemic key">
      <summary>§ How to read the metadata</summary>
      <dl>
        <dt>Landmark</dt>
        <dd>Fundamentally alters the trajectory; 2–5 per year.</dd>
        <dt>Major</dt>
        <dd>Meaningfully shifts the landscape; 2–4 per month.</dd>
        <dt>Notable</dt>
        <dd>Worth documenting; significance can be upgraded later.</dd>
        <dt>Confidence</dt>
        <dd>High = primary sources corroborate. Medium = credible secondary only. Low = provisional. Disputed = credible sources disagree.</dd>
        <dt>Contestation</dt>
        <dd>Uncontested = no formal challenge. Contested = at least one challenge open. Superseded = replaced by a later entry. Unresolved = dispute still open.</dd>
      </dl>
    </details>

    {hasSigHistory && (
      <section class="wiki-section">
        <h2 class="wiki-article__h2">Significance history</h2>
        <SignificanceHistory history={event.significance_history} />
      </section>
    )}

    {records.length > 0 && (
      <Fragment slot="revisions">
        <ol class="revision-log">
          {records.map((record) => record.kind === 'revision' ? (
            <li class="revision-log__entry">
              <h3 class="revision-log__title">
                Summary revised
                {record.date && <time class="revision-log__date" datetime={record.date}>{record.date}</time>}
              </h3>
              <dl class="revision-log__fields">
                <dt>Reason</dt>
                <dd>{record.revision.reason}</dd>
                {record.revision.new_version && <><dt>Revised summary</dt><dd>{record.revision.new_version}</dd></>}
                {record.revision.prior_version && (
                  <>
                    <dt>Earlier summary</dt>
                    <dd>
                      <details class="revision-log__earlier">
                        <summary>Show the earlier summary</summary>
                        <p>{record.revision.prior_version}</p>
                      </details>
                    </dd>
                  </>
                )}
              </dl>
            </li>
          ) : (
            <li class="revision-log__entry">
              <h3 class="revision-log__title">
                Challenge opened
                {record.date && <time class="revision-log__date" datetime={record.date}>{record.date}</time>}
              </h3>
              <dl class="revision-log__fields">
                <dt>Status</dt>
                <dd>{plainWords(record.challenge.status)}</dd>
                <dt>Allegations</dt>
                <dd>{record.challenge.allegations.map(plainWords).join(', ')}</dd>
                {record.resolution && (
                  <>
                    <dt>Resolution</dt>
                    <dd>
                      {plainWords(record.resolution.disposition)}
                      {record.resolution.issued_at && <>, issued <time class="revision-log__date" datetime={record.resolution.issued_at}>{record.resolution.issued_at}</time></>}
                      <ul>{record.resolution.findings.map((finding) => <li>{finding}</li>)}</ul>
                    </dd>
                  </>
                )}
              </dl>
            </li>
          ))}
        </ol>
      </Fragment>
    )}

    <!-- References -->
    {event.sources && event.sources.length > 0 && (
      <Fragment slot="references">
        <ol>
          {event.sources.map((source: any) => (
            <li>
              <a href={source.url} target="_blank" rel="noopener noreferrer">
                {source.title || source.url}
              </a>
              {source.publisher && <span class="ref-meta">, {source.publisher}</span>}
              {source.date && <span class="ref-date font-mono"> ({source.date})</span>}
              {source.type && (
                <span class={`flag-chip ref-type${isPrimary(source.type) ? ' ref-type--primary' : ''}`}>
                  {formatSourceType(source.type)}
                </span>
              )}
              {source.archive_url && (
                <>
                  {' '}
                  <a href={source.archive_url} target="_blank" rel="noopener noreferrer" class="ref-archive">
                    archived copy
                  </a>
                </>
              )}
            </li>
          ))}
        </ol>
      </Fragment>
    )}

    <!-- See also -->
    {(ownRelated.length > 0 || referencedBy.length > 0) && (
      <Fragment slot="seeAlso">
        {ownRelated.length > 0 && (
          <ul>
            {ownRelated.map((e) => (
              <li>
                <a href={`/events/${e.slug}`}>{e.title}</a>
                <time class="see-also__date font-mono" datetime={e.date}> — {e.date}</time>
              </li>
            ))}
          </ul>
        )}
        {referencedBy.length > 0 && (
          <>
            <h3 class="see-also__label" id="referenced-by">Referenced by</h3>
            <ul aria-labelledby="referenced-by">
              {referencedBy.map((e) => (
                <li>
                  <a href={`/events/${e.slug}`}>{e.title}</a>
                  <time class="see-also__date font-mono" datetime={e.date}> — {e.date}</time>
                </li>
              ))}
            </ul>
          </>
        )}
      </Fragment>
    )}
  </ArticleShell>
</Base>

<script is:inline data-event-id={event.id} data-event-title={event.title} data-event-category={event.category}>
  const { eventId, eventTitle, eventCategory } = document.currentScript.dataset;
  document.addEventListener('DOMContentLoaded', function () {
    // Track source reference link clicks
    document.querySelectorAll('.wiki-article__references a[target="_blank"]:not(.ref-archive)').forEach(function (el) {
      el.addEventListener('click', function () {
        window.posthog?.capture('source_link_clicked', {
          event_id: eventId,
          event_title: eventTitle,
          event_category: eventCategory,
          source_title: el.textContent?.trim(),
        });
      });
    });

    // Track archive copy link clicks
    document.querySelectorAll('a.ref-archive').forEach(function (el) {
      el.addEventListener('click', function () {
        window.posthog?.capture('archive_link_clicked', {
          event_id: eventId,
          event_title: eventTitle,
        });
      });
    });
  });
</script>

<style>
  .wiki-section { margin-top: 2rem; }
  .rail-list--stacked > li { display: block; }
  .rail-stack { padding: 5px 0; line-height: 1.45; }
  .rail-stack__date,
  .rail-stack__meta { display: block; font-size: var(--text-meta); color: var(--color-ink-faint); margin-top: 1px; line-height: 1.45; }
  .rail-stack__type { text-transform: capitalize; }
  .rail-stack__role { margin-left: 3px; }
  .infobox-role { color: var(--color-ink-faint); font-size: var(--text-meta); line-height: 1.45; }

  /* Mobile-only epistemic key — the right rail is hidden below 780px,
     so we duplicate the definitions at the end of the article body. */
  .mobile-epistemic-key {
    display: none;
    margin: 24px 0 0;
    padding: 14px 16px 16px;
    background: var(--color-wiki-surface);
    border: 1px solid var(--color-rule-strong);
    border-radius: 2px;
    font-family: var(--font-sans);
    font-size: var(--text-meta);
    line-height: 1.5;
    color: var(--color-ink-mid);
  }
  .mobile-epistemic-key > summary {
    cursor: pointer;
    font-size: var(--text-label);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    padding: 2px 0;
    line-height: 1.4;
  }
  .mobile-epistemic-key > summary:hover { color: var(--color-wiki-link); }
  .mobile-epistemic-key[open] > summary { margin-bottom: 10px; }
  .mobile-epistemic-key dl {
    margin: 0;
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 6px 14px;
  }
  .mobile-epistemic-key dt {
    font-size: var(--text-label);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-ink-muted);
    margin: 0;
    line-height: 1.4;
  }
  .mobile-epistemic-key dd {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--text-meta);
    color: var(--color-ink-mid);
    line-height: 1.45;
  }
  @media (max-width: 780px) {
    .mobile-epistemic-key { display: block; }
  }

  .epistemic-key { display: grid; grid-template-columns: 1fr; gap: 2px 0; margin: 0; }
  .epistemic-key dt {
    margin-top: 6px; font-family: var(--font-sans); font-size: var(--text-label); font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-ink-muted);
    line-height: 1.4;
  }
  .epistemic-key dt:first-child { margin-top: 0; }
  .epistemic-key__term--landmark { color: #7A5A00; }
  .epistemic-key__term--major { color: #0A4D82; }
  .epistemic-key__term--notable { color: #5C564D; }
  .epistemic-key dd { margin: 2px 0 0; font-size: var(--text-meta); color: var(--color-ink-mid); line-height: 1.45; }

  .revision-log { list-style: none; margin: 0; padding: 0; }
  .revision-log__entry { padding: 14px 0 16px; border-bottom: 1px solid var(--color-rule); }
  .revision-log__entry:first-child { padding-top: 4px; }
  .revision-log__entry:last-child { border-bottom: none; }
  .revision-log__title {
    margin: 0 0 10px; font-family: var(--font-sans); font-size: var(--text-label); font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-ink); line-height: 1.4;
  }
  .revision-log__date {
    margin-left: 8px; font-family: var(--font-mono); font-weight: 400; text-transform: none; letter-spacing: 0;
    color: var(--color-ink-faint);
  }
  .revision-log__fields { margin: 0; }
  .revision-log__fields dt {
    margin-top: 10px; font-family: var(--font-sans); font-size: var(--text-label); font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-ink-muted); line-height: 1.4;
  }
  .revision-log__fields dt:first-child { margin-top: 0; }
  .revision-log__fields dd {
    margin: 2px 0 0; max-width: 68ch; font-family: var(--font-serif); font-size: 0.9375rem;
    color: var(--color-ink-mid); line-height: 1.6;
  }
  .revision-log__fields dd ul { margin: 4px 0 0; padding-left: 1.25rem; }
  .revision-log__earlier > summary {
    cursor: pointer; font-family: var(--font-sans); font-size: var(--text-meta); color: var(--color-wiki-link);
    line-height: 1.45;
  }
  .revision-log__earlier > summary:hover { text-decoration: underline; }
  .revision-log__earlier p { margin: 6px 0 0; padding-left: 12px; border-left: 3px solid var(--color-rule-strong); }
  @media print {
    .revision-log__earlier > summary { display: none; }
    .revision-log__earlier::details-content { content-visibility: visible; display: block; block-size: auto; }
    .revision-log__earlier p { margin-top: 0; }
  }

  .ref-meta { color: var(--color-ink-mid); }
  .ref-date { font-size: var(--text-meta); color: var(--color-ink-faint); line-height: 1.45; }
  .ref-type { margin-left: 6px; text-transform: lowercase; }
  .ref-type--primary { background: #DBECF9; color: #0A4D82; }
  .ref-archive {
    font-family: var(--font-sans); font-size: var(--text-meta); color: var(--color-ink-faint);
    text-decoration: underline dotted;
    line-height: 1.45;
  }
  .ref-archive:hover { color: var(--color-wiki-link); }
  .see-also__date { color: var(--color-ink-faint); font-size: var(--text-meta); font-style: normal; line-height: 1.45; }
  .see-also__label {
    margin: 14px 0 6px; font-family: var(--font-sans); font-size: var(--text-label); font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-ink-muted); line-height: 1.4;
  }
  .see-also__label:first-child { margin-top: 0; }

  .thread-nav { margin: 2rem 0 0; padding: 12px 0 14px; border-top: 1px solid var(--color-rule); border-bottom: 1px solid var(--color-rule); }
  .thread-nav + .thread-nav { margin-top: 0; border-top: none; }
  .thread-nav__thread { display: inline-block; font-family: var(--font-sans); font-size: var(--text-meta); line-height: 1.45; }
  .thread-nav__steps { display: grid; grid-template-columns: 1fr 1fr; gap: 10px 24px; margin-top: 8px; }
