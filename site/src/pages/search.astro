---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/wiki/PageHeader.astro';
import RailSection from '../components/wiki/RailSection.astro';
import CategoryTag from '../components/wiki/CategoryTag.astro';
import { getCategories, loadEvents } from '../lib/content';

// Archive-wide search over the Pagefind index that the site build writes to /pagefind/.
// The groups follow the `type` filter each record carries (see ArticleShell).
const groups = [
  { type: 'event', label: 'Events', noun: 'events' },
  { type: 'thread', label: 'Threads', noun: 'threads' },
  { type: 'controversy', label: 'Controversies', noun: 'controversies' },
  { type: 'actor', label: 'Actors', noun: 'actors' },
];
const categories = getCategories();
// The entry filters offer every year with an entry, newest first, as the timeline does.
const years = [...new Set(loadEvents().map((event) => event.date.slice(0, 4)))].sort().reverse();
// The chip classes of the timeline's filters (Explorer.tsx), with the pressed state set by aria-pressed.
// Whole class names, so Tailwind finds them.
const pip: Record<string, string> = {
  policy: 'bg-category-policy',
  models: 'bg-category-models',
  research: 'bg-category-research',
  industry: 'bg-category-industry',
  safety: 'bg-category-safety',
  culture: 'bg-category-culture',
  'open-source': 'bg-category-open-source',
};
const chip =
  'inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-sans rounded-sm border min-h-[32px] transition-colors duration-150 cursor-pointer bg-page-bg border-rule text-ink-muted hover:text-ink hover:border-rule-strong aria-pressed:bg-wiki-surface aria-pressed:border-rule-strong aria-pressed:text-ink aria-pressed:font-semibold';
---

<Base
  layout="index"
  title="Search"
  description="Search every entry, thread, controversy and actor in The Ledger."
>
  <Fragment slot="leftRail">
    <RailSection title="Navigate">
      <ul class="rail-list">
        <li><a href="/">Main page</a></li>
        <li><a href="/explore">Timeline</a></li>
        <li><a href="/threads">Threads</a></li>
        <li><a href="/controversies">Controversies</a></li>
        <li><a href="/actors">Actors</a></li>
        <li><a href="/about">About the ledger</a></li>
      </ul>
    </RailSection>
  </Fragment>

  <PageHeader eyebrow="§ Search" title="Search the ledger" noRule />

  <noscript>
    <p class="search-notice">
      Search needs JavaScript. Without it, you can browse the <a href="/explore">timeline</a>.
    </p>
  </noscript>

  <!-- Hidden until the script below runs, so readers without JavaScript see only the notice. -->
  <div id="search-app" hidden>
    <form id="search-form" class="search-form" action="/search" method="get" role="search">
      <label for="search-page-q" class="sr-only">Search the ledger</label>
      <input
        type="search"
        id="search-page-q"
        class="ph-no-capture"
        name="q"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        enterkeyhint="search"
        aria-describedby="search-page-hint"
      />
      <p id="search-page-hint" class="search-hint">Put a phrase in quotes to match it exactly.</p>
    </form>

    <p id="search-status" class="search-status ph-no-capture" role="status">
      Search every entry, thread, controversy and actor in the ledger.
    </p>

    <div class="ph-no-capture">
      <!-- The entry filters, shown while the Events group has entries for the query. -->
      <div class="search-filters flex flex-col gap-3 p-4 rounded-sm border border-rule-strong bg-wiki-surface/60" role="group" aria-labelledby="search-filters-head" aria-describedby="search-filters-note" hidden>
        <p class="search-filters__intro">
          <span id="search-filters-head" class="label-eyebrow">Filter entries</span>
          <span id="search-filters-note">Threads, controversies and actors are not filtered.</span>
        </p>
        <div class="flex flex-wrap items-baseline gap-2" role="group" aria-labelledby="search-filters-cat">
          <span id="search-filters-cat" class="label-eyebrow mr-1">Category</span>
          {categories.map(({ id, label }) => (
            <button type="button" class={chip} data-search-filter="cat" value={id} data-label={label} aria-pressed="false">
              <span aria-hidden="true" class={`inline-block w-1.5 h-1.5 rounded-full ${pip[id]}`}></span>
              <span>{label}</span>
              <span class="search-filters__count font-mono tabular-nums"></span>
            </button>
          ))}
        </div>
        <div class="flex flex-wrap items-baseline gap-2" role="group" aria-labelledby="search-filters-year">
          <span id="search-filters-year" class="label-eyebrow mr-1">Year</span>
          <button type="button" class={chip} data-search-filter="year" value="" aria-pressed="true">
            <span>All</span>
            <span class="search-filters__count font-mono tabular-nums"></span>
          </button>
          {years.map((year) => (
            <button type="button" class={`${chip} font-mono tabular-nums`} data-search-filter="year" value={year} aria-pressed="false">
              <span>{year}</span>
              <span class="search-filters__count"></span>
            </button>
          ))}
        </div>
      </div>
      {groups.map(({ type, label, noun }) => (
        <section class="search-group" data-search-group={type} data-search-noun={noun} aria-labelledby={`search-${type}-head`} hidden>
          <h2 class="search-group__head" id={`search-${type}-head`}>
            {label}
            <span class="search-group__count font-mono"></span>
          </h2>
          <ol class="search-group__list"></ol>
          {type === 'event' && <p class="search-group__none" hidden>No entries match these filters.</p>}
          <button type="button" class="search-group__more" hidden></button>
        </section>
      ))}
    </div>

    <template id="search-result">
      <li class="search-result">
        <a class="search-result__title"></a>
        <p class="search-result__meta"><time class="search-result__date"></time></p>
        <p class="search-result__excerpt"></p>
      </li>
    </template>
    {categories.map(({ id }) => (
      <template data-search-category={id}><CategoryTag category={id} /></template>
    ))}
    <template id="search-empty">
      No results for “<span data-query></span>”. Try fewer words, or browse the
      <a href="/explore">timeline</a>, <a href="/threads">threads</a> or <a href="/actors">actors</a>.
    </template>
    <template id="search-failed">
      Search could not load. Reload the page, or browse the <a href="/explore">timeline</a>.
    </template>
  </div>
  <script is:inline>
    document.getElementById('search-app').hidden = false;
  </script>
</Base>

<script>
  type Fragment = {
    url: string;
    excerpt: string;
    meta: { title: string; date?: string };
    filters: { category?: string[] };
  };
  type Result = { data: () => Promise<Fragment> };
  type Ranking = { termSimilarity: number; termFrequency: number; metaWeights: Record<string, number> };
  type Filters = { type: string; category?: { any: string[] }; year?: string };
  // The number of results for each value of each filter, if that value were added to the search's filters.
  type Counts = Record<string, Record<string, number>>;
  type Pagefind = {
    options: (options: { excerptEllipsis: string; ranking: Ranking }) => Promise<void>;
    init: () => Promise<void>;
    // Loads the filter values, so that each search also returns its counts.
    filters: () => Promise<Counts>;
    search: (term: string, options: { filters: Filters }) => Promise<{ results: Result[]; filters: Counts }>;
  };

  // Results shown per group at first, and added by each "Show more".
  const STEP = 10;
  // Pause after the last keystroke before searching.
  const DELAY_MS = 200;
  // A variable, so the bundler leaves the import for the browser: the index exists only after the build.
  const PAGEFIND_URL = '/pagefind/pagefind.js';
  // Pagefind matches each query word as a prefix, so `gpt-4` also finds `gpt-4o`. These values rank a
  // record whose title has the query's words first: termSimilarity (default 1) favours the word as typed
  // over longer words that start with it, termFrequency (default 1) lets a few matches in a long record
  // count, and the title weight (default 5) favours words in the title. The expected order is in
  // tests/search.spec.ts.
  const RANKING: Ranking = { termSimilarity: 20, termFrequency: 0.5, metaWeights: { title: 30 } };

  const input = document.querySelector<HTMLInputElement>('#search-page-q')!;
  const status = document.querySelector<HTMLElement>('#search-status')!;
  const help = status.textContent!.trim();
  const template = (selector: string) => document.querySelector<HTMLTemplateElement>(selector)!.content;
  const groups = [...document.querySelectorAll<HTMLElement>('[data-search-group]')].map((section) => ({
    type: section.dataset.searchGroup!,
    noun: section.dataset.searchNoun!,
    section,
    count: section.querySelector<HTMLElement>('.search-group__count')!,
    list: section.querySelector<HTMLElement>('.search-group__list')!,
    more: section.querySelector<HTMLButtonElement>('.search-group__more')!,
    results: [] as Result[],
    // The results whose next rows are loading, so a second activation of Show more waits for them.
    loading: undefined as Result[] | undefined,
  }));
  type Group = (typeof groups)[number];

  // The category and year filters of the Events group, kept in the address as `cat` and `year`, the
  // names the timeline uses. Each chip shows how many entries choosing it would list.
  const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-search-filter]')];
  const categoryChips = chips.filter((chip) => chip.dataset.searchFilter === 'cat');
  const yearChips = chips.filter((chip) => chip.dataset.searchFilter === 'year');
  const filterPanel = document.querySelector<HTMLElement>('.search-filters')!;
  const noEntries = document.querySelector<HTMLElement>('.search-group__none')!;
  const params = new URL(location.href).searchParams;
  let categories = categoryChips.map((chip) => chip.value).filter((id) => params.get('cat')?.split(',').includes(id));
  // The All chip's value is the empty string.
  let year = yearChips.find((chip) => chip.value && chip.value === params.get('year'))?.value ?? '';

  const entryFilters = (cats: string[], yr: string): Filters => ({
    type: 'event',
    ...(cats.length > 0 && { category: { any: cats } }),
    ...(yr && { year: yr }),
  });

  function pressChips() {
    for (const chip of categoryChips) chip.setAttribute('aria-pressed', String(categories.includes(chip.value)));
    for (const chip of yearChips) chip.setAttribute('aria-pressed', String(chip.value === year));
  }

  // A chip that would list no entries is disabled, unless it is pressed, so that it can be released.
  function countChips(chipsOfFilter: HTMLButtonElement[], counts: Record<string, number>) {
    for (const chip of chipsOfFilter) {
      const count = counts[chip.value] ?? 0;
      chip.querySelector('.search-filters__count')!.textContent = String(count);
      if (count === 0 && chip.getAttribute('aria-pressed') === 'false') chip.setAttribute('aria-disabled', 'true');
      else chip.removeAttribute('aria-disabled');
    }
  }

  // For the status line, such as ", with entries limited to Policy or Safety in 2025".
  function filterSummary() {
    const names = categoryChips.filter((chip) => categories.includes(chip.value)).map((chip) => chip.dataset.label);
    if (names.length === 0 && !year) return '';
    return `, with entries limited to ${[names.join(' or '), year].filter(Boolean).join(' in ')}`;
  }

  let pagefind: Promise<Pagefind> | undefined;
  function loadPagefind() {
    pagefind ??= import(/* @vite-ignore */ PAGEFIND_URL).then(async (module: Pagefind) => {
      await module.options({ excerptEllipsis: '…', ranking: RANKING });
      await module.init();
      await module.filters();
      return module;
    });
    return pagefind;
  }

  // Pagefind escapes angle brackets in the page text and wraps each matching word in <mark>.
  function excerptNodes(excerpt: string) {
    return excerpt.split(/<\/?mark>/).map((piece, index) => {
      const text = piece.replace(/&lt;/g, '<').replace(/&gt;/g, '>');
      if (index % 2 === 0) return text;
      const mark = document.createElement('mark');
      mark.textContent = text;
      return mark;
    });
  }

  async function rows(results: Result[], type: string) {
    const fragments = await Promise.all(results.map((result) => result.data()));
    return fragments.map((fragment) => {
      const row = template('#search-result').firstElementChild!.cloneNode(true) as HTMLElement;
      const link = row.querySelector('a')!;
      // The site links to records without the trailing slash.
      link.href = fragment.url.replace(/\/$/, '');
      link.textContent = fragment.meta.title;
      const meta = row.querySelector('.search-result__meta')!;
      if (type === 'event') {
        const time = meta.querySelector('time')!;
        time.dateTime = time.textContent = fragment.meta.date ?? '';
        meta.append(template(`[data-search-category="${fragment.filters.category?.[0]}"]`).cloneNode(true));
      } else {
        meta.remove();
      }
      row.querySelector('.search-result__excerpt')!.append(...excerptNodes(fragment.excerpt));
      return row;
    });
  }

  function message(selector: string, term = '') {
    const content = template(selector).cloneNode(true) as DocumentFragment;
    const query = content.querySelector('[data-query]');
    if (query) query.textContent = term;
    status.replaceChildren(content);
  }

  // The status line for the results on the page, restored when a failed Show more succeeds on retry.
  let summary = help;
  let latest = 0;
  async function search() {
    const run = ++latest;
    const term = input.value.trim();
    const url = new URL(location.href);
    for (const [key, value] of [['q', term], ['cat', categories.join(',')], ['year', year]]) {
      if (value) url.searchParams.set(key, value);
      else url.searchParams.delete(key);
    }
    history.replaceState(history.state, '', url);
    pressChips();

    let found: Result[][] = groups.map(() => []);
    let first: HTMLElement[][] = groups.map(() => []);
    // The entries for the term before the category and year filters.
    let entries = 0;
    let categoryCounts: Record<string, number> = {};
    let yearCounts: Record<string, number> = {};
    let failed = false;
    if (term) {
      try {
        const index = await loadPagefind();
        const [searches, unfiltered, byCategory, byYear] = await Promise.all([
          Promise.all(groups.map(({ type }) =>
            index.search(term, { filters: type === 'event' ? entryFilters(categories, year) : { type } }))),
          index.search(term, { filters: entryFilters([], '') }),
          // Each filter's counts leave out that filter's own choice, so that choosing a second category adds to the first.
          index.search(term, { filters: entryFilters([], year) }),
          index.search(term, { filters: entryFilters(categories, '') }),
        ]);
        const results = searches.map((search) => search.results);
        first = await Promise.all(results.map((matches, i) => rows(matches.slice(0, STEP), groups[i].type)));
        found = results;
        entries = unfiltered.results.length;
        categoryCounts = byCategory.filters.category ?? {};
        yearCounts = { ...byYear.filters.year, '': byYear.results.length };
      } catch {
        failed = true;
      }
      // A newer keystroke has started its own search.
      if (run !== latest) return;
    }

    groups.forEach((group, i) => {
      group.results = found[i];
      // The Events group stays while its filters leave no entries, so that they can be changed.
      group.section.hidden = (group.type === 'event' ? entries : found[i].length) === 0;
      group.count.textContent = String(found[i].length);
      group.list.replaceChildren(...first[i]);
      updateMore(group);
    });
    countChips(categoryChips, categoryCounts);
    countChips(yearChips, yearCounts);
    filterPanel.hidden = entries === 0;
    noEntries.hidden = !(entries > 0 && found[groups.findIndex(({ type }) => type === 'event')].length === 0);
    const total = found.reduce((sum, results) => sum + results.length, 0);
    summary = term
      ? `${total} ${total === 1 ? 'result' : 'results'} for “${term}”${entries > 0 ? filterSummary() : ''}`
      : help;
    if (failed) message('#search-failed');
    else if (term && total === 0 && entries === 0) message('#search-empty', term);
    else status.textContent = summary;
  }

  // The button names how many results its next activation adds.
  function updateMore(group: Group) {
    const left = group.results.length - group.list.children.length;
    group.more.hidden = left <= 0;
    // The group type is the singular of its noun.
    group.more.textContent = left === 1 ? `Show 1 more ${group.type}` : `Show ${Math.min(STEP, left)} more ${group.noun}`;
  }

  for (const group of groups) {
    group.more.addEventListener('click', async () => {
      const { results, list } = group;
      if (group.loading === results) return;
      group.loading = results;
      try {
        const added = await rows(results.slice(list.children.length, list.children.length + STEP), group.type);
        // A new search replaced this list while the rows loaded.
        if (results !== group.results) return;
        list.append(...added);
        updateMore(group);
        if (status.textContent !== summary) status.textContent = summary;
        // Keyboard readers continue from the first added result.
        added[0]?.querySelector('a')?.focus();
      } catch {
        if (results === group.results) message('#search-failed');
      } finally {
        if (group.loading === results) group.loading = undefined;
      }
    });
  }

  let timer: number | undefined;
  for (const chip of chips) {
    chip.addEventListener('click', () => {
      if (chip.getAttribute('aria-disabled') === 'true') return;
      if (chip.dataset.searchFilter === 'cat') {
        categories = categories.includes(chip.value)
          ? categories.filter((id) => id !== chip.value)
          : [...categories, chip.value];
      } else {
        year = year === chip.value ? '' : chip.value;
      }
      window.clearTimeout(timer);
      search();
    });
  }

  input.addEventListener('input', () => {
    window.clearTimeout(timer);
    timer = window.setTimeout(search, DELAY_MS);
  });
  input.form!.addEventListener('submit', (event) => {
    event.preventDefault();
    window.clearTimeout(timer);
    search();
  });

  input.value = new URL(location.href).searchParams.get('q') ?? '';
  if (input.value.trim()) search();
  else loadPagefind().catch(() => {});
</script>

<style>
  .search-notice {
    max-width: 65ch;
    margin: 0;
    color: var(--color-ink);
  }

  .search-form input {
    width: 100%;
    max-width: 40rem;
    min-height: 48px;
    padding: 12px 14px;
    border: 1px solid var(--color-control-border);
    border-radius: 2px;
    background: var(--color-page-bg);
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-size: 1rem;
  }
  .search-form input:focus-visible {
    outline: 2px solid var(--color-wiki-link);
    outline-offset: 0;
    border-color: var(--color-wiki-link);
  }

  .search-hint {
    margin: 8px 0 0;
    font-family: var(--font-sans);
    font-size: var(--text-meta);
    line-height: 1.45;
    color: var(--color-ink-faint);
  }

  .search-status {
    margin: 12px 0 32px;
    font-family: var(--font-sans);
    font-size: var(--text-small);
    line-height: 1.5;
    color: var(--color-ink-mid);
  }

  .search-group {
    margin-bottom: 40px;
  }
  .search-group__head {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 36, 'SOFT' 0, 'WONK' 0;
    font-size: 1.5rem;
    font-weight: 500;
    color: var(--color-ink-dim);
    margin: 0;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--color-rule-strong);
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .search-group__count {
    font-size: var(--text-meta);
    font-weight: 400;
    color: var(--color-ink-faint);
    letter-spacing: 0.04em;
    line-height: 1.45;
  }
  .search-filters {
    margin-bottom: 32px;
  }
  .search-filters__intro {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 10px;
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--text-meta);
    line-height: 1.45;
    color: var(--color-ink-faint);
  }
  /* The display classes would otherwise show a hidden panel. */
  .search-filters[hidden] {
    display: none;
  }
  /* A chip that would list no entries. */
  .search-filters button[aria-disabled='true'] {
    border-style: dashed;
    border-color: var(--color-rule-strong);
    color: var(--color-ink-faint);
    cursor: default;
  }
  .search-filters__count {
    color: var(--color-ink-faint);
    font-weight: 400;
  }
  .search-group__none {
    margin: 14px 0 0;
    font-family: var(--font-sans);
    font-size: var(--text-small);
    color: var(--color-ink-mid);
  }

  .search-group__list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .search-group__more {
    margin-top: 14px;
    min-height: 40px;
    padding: 8px 14px;
    border: 1px solid var(--color-control-border);
    border-radius: 2px;
    background: var(--color-page-bg);
    color: var(--color-ink);
    font-family: var(--font-sans);
    font-size: var(--text-small);
    cursor: pointer;
    transition: background 120ms ease;
  }
  .search-group__more:hover {
    background: var(--color-wiki-surface);
  }

  .search-result {
    padding: 12px 0;
    border-bottom: 1px solid var(--color-rule);
  }
  .search-result__title {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    font-weight: 500;
    line-height: 1.3;
    color: var(--color-wiki-link);
  }
  .search-result__title:visited { color: var(--color-wiki-link-visited); }
  .search-result__title:hover { text-decoration: underline; }
  .search-result__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 12px;
    margin: 3px 0 0;
  }
  .search-result__date {
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    color: var(--color-ink-faint);
    letter-spacing: 0.02em;
    line-height: 1.45;
  }
  .search-result__excerpt {
    max-width: 68ch;
    margin: 4px 0 0;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-ink-mid);
  }
  .search-result__excerpt :global(mark) {
    padding: 0 2px;
    border-radius: 2px;
    background: var(--color-wiki-surface-strong);
    color: var(--color-ink);
    font-weight: 600;
  }
</style>
