---
interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  url?: string;
  type?: string;
  /** ISO date written as `article:published_time` on article pages. */
  publishedTime?: string;
  /** schema.org objects, each written as its own JSON-LD block. */
  structuredData?: object[];
}

const {
  title = 'The Ledger — A durable historical record of AI',
  description = 'Track events, debates, and turning points in AI history. Open-source, community-maintained, epistemically rigorous.',
  image = '/og/default.png',
  imageAlt = 'The Ledger: A sourced historical record of AI',
  url,
  type = 'website',
  publishedTime,
  structuredData = [],
} = Astro.props;

const canonicalURL = url || new URL(Astro.url.pathname, Astro.site || 'https://the-ledger.net').toString();
const imageURL = image.startsWith('http') ? image : new URL(image, Astro.site || 'https://the-ledger.net').toString();
// "<" is escaped so text in the data can never close the script element.
const jsonLd = (data: object) => JSON.stringify(data).replace(/</g, '\\u003c');
---

<!-- Primary Meta Tags -->
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:site_name" content="The Ledger" />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />

{structuredData.map((data) => <script is:inline type="application/ld+json" set:html={jsonLd(data)} />)}
