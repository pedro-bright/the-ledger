---
import { anchorSections } from '../../lib/markdown';

// Article-page shell: breadcrumb → title → subtitle → markers → body → footer.
// With a `lead` slot, the metadata disclosure follows the lead and starts closed on phones; on
// desktop the script below moves it before the lead and opens it, so it floats beside the text.
// Without a `lead` slot, the infobox floats directly in the body.
// Page provides `markers`, `infobox`, `lead`, default body, `references`, `seeAlso`, `footer` via slots.
interface Props {
  title: string;
  subtitle?: string;
  breadcrumb?: Array<{ label: string; href?: string }>;
  /** Last modified ISO date — shown in the footer line. */
  lastModified?: string;
  lastReviewed?: string;
  /** Source file on GitHub (for "View source" editorial transparency). */
  sourcePath?: string;
}

const { title, subtitle, breadcrumb = [], lastModified, lastReviewed, sourcePath } = Astro.props;
const hasMarkers = Astro.slots.has('markers');
const hasInfobox = Astro.slots.has('infobox');
const hasLead = Astro.slots.has('lead');
const hasReferences = Astro.slots.has('references');
const hasSeeAlso = Astro.slots.has('seeAlso');
const hasFooter = Astro.slots.has('footer');
const usedAnchors = new Set(['refs-head', 'see-also-head', 'article-contents']);
const lead = anchorSections(hasLead ? await Astro.slots.render('lead') : '', usedAnchors);
const body = anchorSections(await Astro.slots.render('default'), usedAnchors);
const sections = [...lead.sections, ...body.sections];
const isLong = sections.length >= 4 || `${lead.content}${body.content}`.replace(/<[^>]*>/g, '').length >= 4000;
if (hasReferences) sections.push({ id: 'refs-head', title: 'References', level: 2 });
if (hasSeeAlso) sections.push({ id: 'see-also-head', title: 'See also', level: 2 });
---
<article class="wiki-article">
  {breadcrumb.length > 0 && (
    <nav class="wiki-article__breadcrumb" aria-label="Breadcrumb">
      {breadcrumb.map((crumb, i) => (
        <Fragment>
          {i > 0 && <span class="wiki-article__crumb-sep" aria-hidden="true">›</span>}
          {crumb.href ? (
            <a href={crumb.href}>{crumb.label}</a>
          ) : (
            <span class="wiki-article__crumb-current" aria-current="page">{crumb.label}</span>
          )}
        </Fragment>
      ))}
    </nav>
  )}

  <header class="wiki-article__header">
    <h1 class="wiki-article__title">{title}</h1>
    {subtitle && <p class="wiki-article__subtitle">{subtitle}</p>}
    {hasMarkers && <div class="wiki-article__markers"><slot name="markers" /></div>}
    {hasReferences && <a class="wiki-article__references-link" href="#refs-head">References</a>}
  </header>

  {isLong && sections.length > 1 && (
    <nav id="article-contents" class="article-contents rail-block" aria-label="On this page">
      <details>
        <summary>Contents</summary>
        <ol>
          {sections.map(({ id, title, level }) => (
            <li class:list={{ 'article-contents__subsection': level === 3 }}><a href={`#${id}`}>{title}</a></li>
          ))}
        </ol>
      </details>
    </nav>
  )}

  <div class="wiki-article__body">
    {hasLead && <div class="wiki-article__lead prose"><Fragment set:html={lead.content} /></div>}
    {hasInfobox && (hasLead ? (
      <details class="wiki-article__metadata">
        <summary>Record metadata</summary>
        <slot name="infobox" />
      </details>
    ) : <slot name="infobox" />)}
    <div class="wiki-article__prose prose">
      <Fragment set:html={body.content} />
    </div>
  </div>

  {hasReferences && (
    <section class="wiki-article__references" aria-labelledby="refs-head">
      <h2 id="refs-head" class="wiki-article__h2">References</h2>
      <slot name="references" />
    </section>
  )}

  {hasSeeAlso && (
    <section class="wiki-article__see-also" aria-labelledby="see-also-head">
      <h2 id="see-also-head" class="wiki-article__h2">See also</h2>
      <slot name="seeAlso" />
    </section>
  )}

  {hasFooter && (
    <div class="wiki-article__footer-slot">
      <slot name="footer" />
    </div>
  )}

  {(lastModified || lastReviewed || sourcePath) && (
    <footer class="wiki-article__lastmod">
      {lastReviewed && (
        <span>This record last reviewed <time datetime={lastReviewed}>{lastReviewed}</time>.</span>
      )}
      {lastModified && (
        <span>This record last modified <time datetime={lastModified}>{lastModified}</time>.</span>
      )}
      {sourcePath && (
        <Fragment>
          {' '}
          <a
            href={`https://github.com/pedro-bright/the-ledger/blob/main/${sourcePath}`}
            target="_blank"
            rel="noopener"
          >View source on GitHub</a>.
        </Fragment>
      )}
    </footer>
  )}
</article>

<script>
  const desktop = window.matchMedia('(min-width: 781px)');
  const contents = document.querySelector<HTMLElement>('#article-contents');
  const contentsHome = contents ? document.createComment('Article contents') : null;
  if (contents && contentsHome) contents.before(contentsHome);
  const syncMetadata = () => {
    if (contents && contentsHome) {
      const rail = document.querySelector('.wiki-rail[data-side="left"]');
      if (desktop.matches && rail) rail.prepend(contents);
      else contentsHome.after(contents);
      contents.querySelector('details')!.open = desktop.matches;
    }
    document.querySelectorAll<HTMLDetailsElement>('.wiki-article__metadata').forEach((details) => {
      const body = details.parentElement!;
      const lead = body.querySelector('.wiki-article__lead')!;
      if (desktop.matches) body.prepend(details);
      else lead.after(details);
      details.open = desktop.matches;
    });
  };
  syncMetadata();
  desktop.addEventListener('change', syncMetadata);
</script>

<style>
  .wiki-article {
    max-width: 100%;
  }
  .wiki-article__references-link {
    display: inline-block;
    margin-top: 12px;
    font: var(--text-meta)/1.45 var(--font-sans);
  }
  .article-contents {
    font: var(--text-meta)/1.45 var(--font-sans);
    margin-bottom: 24px;
  }
  .article-contents summary {
    cursor: pointer;
    padding: 8px 0;
    font-weight: 600;
    color: var(--color-ink-mid);
  }
  .article-contents ol { list-style: none; padding: 0; margin: 4px 0 0; }
  .article-contents li { margin: 0; }
  .article-contents a { display: block; padding: 4px 0; }
  .article-contents__subsection { padding-inline-start: 12px; }
  @media (min-width: 781px) {
    .article-contents ol { max-height: 50vh; overflow-y: auto; }
    .article-contents summary {
      font-family: var(--font-display);
      font-variation-settings: 'opsz' 36, 'SOFT' 0, 'WONK' 0;
      font-size: 15px;
    }
  }
  .wiki-article__breadcrumb {
    font-family: var(--font-sans);
    font-size: var(--text-meta);
    color: var(--color-ink-faint);
    margin-bottom: 16px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: baseline;
    line-height: 1.45;
  }
  .wiki-article__breadcrumb a {
    color: var(--color-wiki-link);
  }
  .wiki-article__breadcrumb a:hover { text-decoration: underline; }
  .wiki-article__crumb-sep {
    color: var(--color-ink-faint);
  }
  .wiki-article__crumb-current {
    color: var(--color-ink-muted);
  }
  .wiki-article__header {
    border-bottom: 1px solid var(--color-rule-strong);
    padding-bottom: 14px;
    margin-bottom: 24px;
  }
  .wiki-article__title {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' var(--display-opsz), 'SOFT' 0, 'WONK' 0;
    font-weight: 500;
    font-size: 2.25rem;
    line-height: 1.1;
    letter-spacing: -0.012em;
    color: var(--color-ink-dim);
    margin: 0;
    text-wrap: balance;
  }
  @media (max-width: 599px) {
    .wiki-article__title { font-size: 2rem; line-height: 1.15; letter-spacing: -0.01em; }
  }
  .wiki-article__subtitle {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 14, 'SOFT' 0, 'WONK' 0;
    font-style: italic;
    font-size: 1.0625rem;
    line-height: 1.5;
    color: var(--color-ink-mid);
    margin: 10px 0 0;
    max-width: 62ch;
  }
  .wiki-article__markers {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin-top: 10px;
  }
  @media (min-width: 781px) and (scripting: enabled) {
    .wiki-article__markers { display: none; }
  }
  /* The prose block is constrained to 68ch on its own; if infobox floats right,
     text wraps naturally around it. No width lockdown here. */
  .wiki-article__body {
    overflow: visible;
  }
  .wiki-article__body::after {
    content: '';
    display: block;
    clear: both;
  }
  .wiki-article__lead {
    margin-bottom: 2rem;
  }
  .wiki-article__metadata {
    float: right;
    width: 280px;
    margin: 4px 0 20px 28px;
  }
  .wiki-article__metadata > summary {
    cursor: pointer;
    font-family: var(--font-sans);
    font-size: var(--text-meta);
    color: var(--color-wiki-link);
    padding: 10px 12px;
    border: 1px solid var(--color-rule-strong);
    background: var(--color-wiki-surface);
    line-height: 1.45;
  }
  .wiki-article__metadata :global(.wiki-infobox) {
    float: none;
    width: 100%;
    margin: 0;
  }
  @media (max-width: 1200px) {
    .wiki-article__metadata { width: 240px; margin: 4px 0 18px 24px; }
  }
  @media (max-width: 1024px) {
    .wiki-article__metadata { width: 260px; }
  }
  @media (min-width: 781px) {
    .wiki-article__metadata[open] > summary { display: none; }
  }
  @media (max-width: 780px) {
    .wiki-article__metadata { float: none; width: 100%; margin: 20px 0; }
  }
  @media print {
    .wiki-article__metadata { float: none; width: 100%; margin: 0 0 20px; }
    .wiki-article__metadata > summary { display: none; }
    .wiki-article__metadata::details-content { content-visibility: visible; display: block; block-size: auto; }
  }
  .wiki-article__h2 {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 36, 'SOFT' 0, 'WONK' 0;
    font-size: 1.5rem;
    font-weight: 500;
    color: var(--color-ink-dim);
    margin: 2rem 0 0.625rem;
    padding-bottom: 0.375rem;
    border-bottom: 1px solid var(--color-rule);
  }
  .wiki-article__references {
    margin-top: 2.5rem;
  }
  .wiki-article__references :global(ol) {
    padding-left: 1.5rem;
    margin: 0;
    font-family: var(--font-serif);
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--color-ink-mid);
  }
  .wiki-article__references :global(ol li) {
    margin-bottom: 8px;
  }
  .wiki-article__references :global(a) {
    color: var(--color-wiki-link);
    text-decoration: underline;
    text-decoration-color: rgba(6, 69, 173, 0.35);
  }
  .wiki-article__references :global(a:hover) {
    text-decoration-color: var(--color-wiki-link);
  }
  .wiki-article__see-also {
    margin-top: 2rem;
  }
  .wiki-article__see-also :global(ul) {
    list-style: disc;
    padding-left: 1.5rem;
    margin: 0;
  }
  .wiki-article__see-also :global(li) {
    margin-bottom: 4px;
    font-size: 0.9375rem;
  }
  .wiki-article__see-also :global(a) {
    color: var(--color-wiki-link);
    text-decoration: underline;
    text-decoration-color: rgba(6, 69, 173, 0.35);
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }
  .wiki-article__see-also :global(a:hover) {
    text-decoration-color: var(--color-wiki-link);
  }
  .wiki-article__lastmod {
    margin-top: 2.5rem;
    padding-top: 10px;
    border-top: 1px solid var(--color-rule);
    font-family: var(--font-sans);
    font-size: var(--text-meta);
    color: var(--color-ink-faint);
    line-height: 1.45;
  }
  .wiki-article__lastmod a {
    color: var(--color-wiki-link);
    text-decoration: underline;
    text-decoration-color: rgba(6, 69, 173, 0.35);
    text-underline-offset: 2px;
  }
  .wiki-article__lastmod a:hover { text-decoration: underline; }
</style>
